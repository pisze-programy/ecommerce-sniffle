{
  "name": "ecommerce-sniffle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/providers",
    "packages/analysis",
    "discovery",
    "backend",
    "orchestrator"
  ],
  "scripts": {
    "build": "npm run format:check && npm run build -w packages/providers && npm run build -w backend && npm run build -w orchestrator",
    "test": "npm run format:check && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "dev:backend": "npm run dev -w backend",
    "dev:orchestrator": "npm run dev -w orchestrator"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
